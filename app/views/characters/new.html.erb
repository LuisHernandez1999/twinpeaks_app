<!DOCTYPE html>
<html>
<head>
  <title>Cadastrar Personagem - Twin Peaks</title>
  <style>
    body {
      background-color: #0a0a0a;
      color: #fff;
      font-family: 'DM Sans', sans-serif;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
    }
    .form-container {
      background-color: #1a1a1a;
      padding: 2rem 3rem;
      border-radius: 12px;
      box-shadow: 0 0 20px rgba(220, 38, 38, 0.5);
      width: 400px;
    }
    h1 {
      color: #dc2626;
      text-align: center;
      margin-bottom: 1.5rem;
      font-family: 'Space Grotesk', sans-serif;
    }
    label {
      display: block;
      margin-top: 1rem;
      color: #f5f5f5;
    }
    input, textarea {
      width: 100%;
      padding: 0.5rem;
      margin-top: 0.25rem;
      border-radius: 6px;
      border: 1px solid #262626;
      background-color: #0a0a0a;
      color: #fff;
    }
    button {
      margin-top: 1.5rem;
      width: 100%;
      padding: 0.75rem;
      background-color: #dc2626;
      border: none;
      border-radius: 8px;
      font-weight: bold;
      cursor: pointer;
      color: white;
      transition: all 0.3s ease;
    }
    button:hover {
      background-color: #b91c1c;
      transform: translateY(-2px);
    }
  </style>
</head>
<body>
  <div class="form-container">
    <h1>Cadastrar Personagem</h1>
    <%= form_with model: @character, local: true do |f| %>
      <% if @character.errors.any? %>
        <div style="color: red; margin-bottom: 1rem;">
          <h4>Erros:</h4>
          <ul>
            <% @character.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= f.label :name, "Nome" %>
      <%= f.text_field :name, placeholder: "Digite o nome do personagem" %>

      <%= f.label :description, "Descrição" %>
      <%= f.text_area :description, placeholder: "Digite a descrição" %>

      <%= f.label :actor, "Ator" %>
      <%= f.text_field :actor, placeholder: "Nome do ator" %>

      <%= f.submit "Cadastrar" %>
    <% end %>

    <div style="text-align: center; margin-top: 1rem;">
      <%= link_to "Ver todos os personagens", characters_path, style: "color: #dc2626; text-decoration: underline;" %>
    </div>
  </div>
</body>
</html>
